/dts-v1/;

/ {
	compatible = "qcom,mtp";
	model = "MTP S3 K81822AA1";
	qcom,msm-name = "SDM632";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,msm-id = <0x15d 0x00>;
	qcom,pmic-id = <0x10016 0x25 0x00 0x00>;
	qcom,pmic-name = "PMI632";

	#include "m1822/msm8953-m1822-cpus.dtsi"

	memory {
		device_type = "memory";
		reg = <0x00 0x10000000 0x00 0x70000000 0x00 0x80000000 0x00 0x80000000>;
	};

	chosen {
		bootargs = "kpti=0 console=ttyMSM0,115200,n8 androidboot.console=ttyMSM0 androidboot.hardware=qcom msm_rtb.filter=0x237 ehci-hcd.park=3 lpm_levels.sleep_disabled=1 androidboot.bootdevice=7824900.sdhci earlycon=msm_serial_dm,0x78af000 buildvariant=user androidboot.emmc=true androidboot.bootreason=hard-reset androidboot.verifiedbootstate=orange androidboot.keymaster=1 androidboot.vbmeta.device=PARTUUID=a4ef1950-da1b-cdbb-c3c6-fdf101db59cf androidboot.vbmeta.avb_version=1.0 androidboot.vbmeta.device_state=unlocked androidboot.vbmeta.hash_alg=sha256 androidboot.vbmeta.size=2240 androidboot.vbmeta.digest=b058b89bf8ea2067828a181bf356c834a3fded39c1219d14f6fb10e8850ff4a1 androidboot.veritymode=enforcing androidboot.serialno=822HEDTS22689 androidboot.efuse=enable printk.kernel_uart_log=disable androidboot.unlocked=1 androidboot.baseband=msm mdss_mdp.panel=1:dsi:0:qcom,mdss_dsi_td4310_csot_fhdp_video:1:none:cfg:single_dsi androidboot.board_id=K81822FA1 board_gpio_num=1 productid=PVT:board_vol=1329076 androidboot.usbst1=0x00 androidboot.selinux=permissive";
		linux,initrd-start = <0x13600000>;
		linux,initrd-end = <0x137879c2>;
		kaslr-seed = <0x00 0x00>;
	};

	aliases {
		i2c3 = "/soc/i2c@78b7000";
		smd8 = "/soc/qcom,smdtty/qcom,smdtty-data4";
		smd36 = "/soc/qcom,smdtty/smdtty-loopback";
		smd6 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-data";
		sdhc2 = "/soc/sdhci@7864900";
		smd4 = "/soc/qcom,smdtty/qcom,smdtty-mbalbridge";
		smd2 = "/soc/qcom,smdtty/smdtty-apps-riva-bt-acl";
		spi3 = "/soc/spi@78b7000";
		i2c2 = "/soc/i2c@78b6000";
		smd7 = "/soc/qcom,smdtty/qcom,smdtty-data1";
		smd5 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-cmd";
		sdhc1 = "/soc/sdhci@7824900";
		smd3 = "/soc/qcom,smdtty/qcom,smdtty-apps-riva-bt-cmd";
		smd1 = "/soc/qcom,smdtty/qcom,smdtty-apps-fm";
		smd21 = "/soc/qcom,smdtty/qcom,smdtty-data21";
		i2c5 = "/soc/i2c@7af5000";
		smd11 = "/soc/qcom,smdtty/qcom,smdtty-data11";
	};

	firmware: firmware {
		phandle = <0x2de>;
		linux,phandle = <0x2de>;

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};

			fstab {
				compatible = "android,fstab";

				system {
					compatible = "android,system";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/system";
					type = "ext4";
					status = "ok";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,discard";
				};

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/vendor";
					type = "ext4";
					status = "ok";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,discard";
				};
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	energy_costs: energy-costs {
		compatible = "sched-energy";
		phandle = <0x2e1>;
		linux,phandle = <0x2e1>;

		CPU_COST_1: core-cost1 {
			idle-cost-data = <0x64 0x50 0x3c 0x28>;
			phandle = <0x0d>;
			busy-cost-data = <0x9ab00 0x2d2 0xdc500 0x507 0x10b300 0x6cb 0x156300 0xb03 0x17bb00 0xdcc 0x1b8a00 0x13ae 0x1e74e0 0x19e0 0x1ec300 0x1a20>;
			linux,phandle = <0x0d>;
		};

		CLUSTER_COST_1: cluster-cost1 {
			idle-cost-data = <0x04 0x03 0x02 0x01>;
			phandle = <0x0e>;
			busy-cost-data = <0x9ab00 0x44 0xdc500 0x67 0x10b300 0x84 0x156300 0xc1 0x17bb00 0xe9 0x1b8a00 0x124 0x1e74e0 0x176 0x1ec300 0x179>;
			linux,phandle = <0x0e>;
		};

		CPU_COST_0: core-cost0 {
			idle-cost-data = <0x14 0x10 0x0c 0x08>;
			phandle = <0x0a>;
			busy-cost-data = <0x96000 0x17 0xd7a00 0x29 0xfd200 0x38 0x14cd00 0x58 0x177000 0x70 0x197d00 0x97 0x1b8a00 0xc2>;
			linux,phandle = <0x0a>;
		};

		CLUSTER_COST_0: cluster-cost0 {
			idle-cost-data = <0x04 0x03 0x02 0x01>;
			phandle = <0x0b>;
			busy-cost-data = <0x96000 0x08 0xd7a00 0x0e 0xfd200 0x12 0x14cd00 0x1c 0x177000 0x23 0x197d00 0x2b 0x1b8a00 0x36>;
			linux,phandle = <0x0b>;
		};
	};

	soc: soc {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0xffffffff>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x1ae>;
		linux,phandle = <0x1ae>;

		dai_tert_auxpcm: qcom,msm-tert-auxpcm {
			qcom,msm-auxpcm-interface = "tertiary";
			compatible = "qcom,msm-auxpcm-dev";
			qcom,msm-cpudai-auxpcm-sync = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-frame = <0x05 0x04>;
			qcom,msm-cpudai-auxpcm-quant = <0x02 0x02>;
			qcom,msm-cpudai-afe-clk-ver = <0x02>;
			qcom,msm-cpudai-auxpcm-slot-mapping = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-num-slots = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-data = <0x00 0x00>;
			qcom,msm-cpudai-auxpcm-pcm-clk-rate = <0x1f4000 0x1f4000>;
			phandle = <0x2c6>;
			qcom,msm-cpudai-auxpcm-mode = <0x00 0x00>;
			linux,phandle = <0x2c6>;
		};

		vfe0: qcom,vfe0@1b10000 {
			qcom,clock-rates = <0x00 0x00 0xfe50fb0 0x00 0x00 0x00 0x00 0x00>;
			vbif-entries = <0x01>;
			ds-entries = <0x11>;
			compatible = "qcom,vfe40";
			clocks = <0x29 0x4e814a78 0x29 0x9894b414 0x29 0xa0c2bd8f 0x29 0xaaa3cd97 0x29 0xcc73453c 0x29 0x4050f47a 0x29 0x77fe2384 0x29 0x3c0a858f>;
			vbif-settings = <0x03>;
			vbif-regs = <0x124>;
