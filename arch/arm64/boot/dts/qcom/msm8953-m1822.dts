		sn_fuse: snfuse@0xa0128 {
			compatible = "qcom,sn-fuse";
			reg-names = "sn-base";
			phandle = <0x256>;
			reg = <0xa0128 0x04>;
			linux,phandle = <0x256>;
		};

		voice: qcom,msm-pcm-voice {
			compatible = "qcom,msm-pcm-voice";
			qcom,destroy-cvd;
			phandle = <0x15e>;
			linux,phandle = <0x15e>;
		};

		ipa_hw: qcom,ipa@07900000 {
			qcom,msm-bus,num-paths = <0x01>;
			qcom,msm-bus,num-cases = <0x03>;
			compatible = "qcom,ipa";
			clocks = <0x29 0xfa685cda>;
			qcom,ipa-hw-mode = <0x00>;
			qcom,msm-bus,vectors-KBps = <0x5a 0x200 0x00 0x00 0x5a 0x200 0x186a0 0xc3500 0x5a 0x200 0x186a0 0x124f80>;
			reg-names = "ipa-base", "bam-base";
			clock-names = "core_clk";
			qcom,modem-cfg-emb-pipe-flt;
			qcom,msm-bus,name = "ipa";
			interrupts = <0x00 0xe4 0x00 0x00 0xe6 0x00>;
			phandle = <0x296>;
			qcom,wan-rx-ring-size = <0xc0>;
			qcom,use-ipa-tethering-bridge;
			qcom,bus-vector-names = "MIN", "SVS", "PERF";
			qcom,lan-rx-ring-size = <0xc0>;
			qcom,ee = <0x00>;
			reg = <0x7900000 0x4effc 0x7904000 0x26934>;
			qcom,ipa-hw-ver = <0x06>;
			linux,phandle = <0x296>;
			interrupt-names = "ipa-irq", "bam-irq";
		};

		tlmm: pinctrl@1000000 {
			interrupts-extended = <0x01 0x00 0xd0 0x00>;
			compatible = "qcom,msm8953-pinctrl";
			gpio-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x10>;
			interrupts = <0x00 0xd0 0x00>;
			phandle = <0xc3>;
			reg = <0x1000000 0x300000>;
			#gpio-cells = <0x02>;
			linux,phandle = <0xc3>;
			interrupt-controller;

			wsa_clk {

				wsa_clk_on: wsa_clk_on {
					phandle = <0x192>;
					linux,phandle = <0x192>;

					mux {
						pins = "gpio25";
						function = "pri_mi2s_mclk_a";
					};

					config {
						pins = "gpio25";
						drive-strength = <0x08>;
						output-high;
					};
				};

				wsa_clk_off: wsa_clk_off {
					phandle = <0x193>;
					linux,phandle = <0x193>;

					mux {
						pins = "gpio25";
						function = "pri_mi2s_mclk_a";
					};

					config {
						output-low;
						pins = "gpio25";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			cdc-pdm-lines {

				cdc_pdm_lines_act: pdm_lines_on {
					phandle = <0x188>;
					linux,phandle = <0x188>;

					mux {
						pins = "gpio69", "gpio73", "gpio74";
						function = "cdc_pdm0";
					};

					config {
						pins = "gpio69", "gpio73", "gpio74";
						drive-strength = <0x08>;
					};
				};

				cdc_pdm_lines_sus: pdm_lines_off {
					phandle = <0x18a>;
					linux,phandle = <0x18a>;

					mux {
						pins = "gpio69", "gpio73", "gpio74";
						function = "cdc_pdm0";
					};

					config {
						pins = "gpio69", "gpio73", "gpio74";
						bias-disable;
						drive-strength = <0x02>;
					};
				};
			};

