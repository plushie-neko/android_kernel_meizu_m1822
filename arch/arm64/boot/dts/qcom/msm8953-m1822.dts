			interrupt-names = "vfe";
			cell-index = <0x00>;
		};

		qcom,csid@1b30800 {
			qcom,clock-rates = <0x00 0x3ab06a0 0x00 0xbebc200 0x00 0x00 0x00 0x00 0x00>;
