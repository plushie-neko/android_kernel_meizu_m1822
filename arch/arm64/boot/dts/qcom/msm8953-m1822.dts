			max-clk-turbo = <0x1bb75640>;
			interrupts = <0x00 0x39 0x00>;
			phandle = <0x2b2>;
			qos-regs = <0x2c4 0x2c8 0x2cc 0x2d0 0x2d4 0x2d8 0x2dc 0x2e0>;
			vdd-supply = <0x14e>;
			reg = <0x1b10000 0x1000 0x1b40000 0x200>;
