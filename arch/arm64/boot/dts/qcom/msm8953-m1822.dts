			qcom,noise-rjct-sda = <0x00>;
			pinctrl-names = "i2c_active", "i2c_sleep";
			qcom,master-id = <0x56>;

			aw87329@58 {
				reset-gpio = <0xc3 0x60 0x00>;
				compatible = "awinic,aw87329_pa";
				status = "okay";
				reg = <0x58>;
			};
		};

		clock_gcc_gfx: qcom,gcc-gfx@1800000 {
