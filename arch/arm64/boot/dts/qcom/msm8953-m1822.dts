				qcom,pm-cluster-level@1 {
					qcom,time-overhead = <0x2f1>;
					qcom,latency-us = <0x1e0>;
					label = "system-wfi";
					qcom,energy-overhead = <0x4ca85>;
					qcom,ss-power = <0x15c>;
					reg = <0x01>;
					qcom,psci-mode = <0x01>;
					qcom,min-child-idx = <0x03>;
