					};

					qcom,pm-cpu {
						qcom,psci-mode-shift = <0x00>;
						qcom,cpu = <0x02 0x03 0x04 0x05>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						qcom,use-prediction;
						qcom,psci-mode-mask = <0x0f>;

						qcom,pm-cpu-level@1 {
							qcom,time-overhead = <0x10e>;
							qcom,psci-cpu-mode = <0x03>;
							qcom,reset-level = <0x03>;
							qcom,latency-us = <0xb4>;
							label = "pc";
							qcom,energy-overhead = <0x1ba3f>;
							qcom,ss-power = <0x169>;
							qcom,is-reset;
							reg = <0x01>;
							qcom,use-broadcast-timer;
						};

						qcom,pm-cpu-level@0 {
							qcom,time-overhead = <0x3d>;
							qcom,psci-cpu-mode = <0x01>;
							qcom,latency-us = <0x01>;
							label = "wfi";
							qcom,energy-overhead = <0x76d8>;
							qcom,ss-power = <0x18b>;
							reg = <0x00>;
						};
					};

					qcom,pm-cluster-level@3 {
						qcom,time-overhead = <0x2b2>;
						qcom,reset-level = <0x03>;
						qcom,latency-us = <0x1a5>;
						label = "pwr-l2-pc";
						qcom,energy-overhead = <0x43be7>;
						qcom,ss-power = <0x15e>;
						qcom,is-reset;
						reg = <0x03>;
						qcom,psci-mode = <0x05>;
						qcom,min-child-idx = <0x01>;
					};

					qcom,pm-cluster-level@0 {
						qcom,time-overhead = <0x10e>;
						qcom,latency-us = <0xb4>;
						label = "pwr-l2-wfi";
						qcom,energy-overhead = <0x1ba3f>;
						qcom,ss-power = <0x169>;
						reg = <0x00>;
						qcom,psci-mode = <0x01>;
					};

					qcom,pm-cluster-level@2 {
						qcom,time-overhead = <0x16b>;
						qcom,reset-level = <0x02>;
						qcom,latency-us = <0xd4>;
						label = "pwr-l2-gdhs";
						qcom,energy-overhead = <0x24cdc>;
						qcom,ss-power = <0x162>;
						reg = <0x02>;
						qcom,psci-mode = <0x04>;
						qcom,min-child-idx = <0x01>;
					};
				};

				qcom,pm-cluster-level@0 {
					qcom,time-overhead = <0x2cf>;
					qcom,latency-us = <0x1a7>;
					label = "system-active";
					qcom,energy-overhead = <0x49066>;
					qcom,ss-power = <0x15d>;
					reg = <0x00>;
					qcom,psci-mode = <0x00>;
				};

				qcom,pm-cluster-level@2 {
					qcom,time-overhead = <0x5d7>;
					qcom,reset-level = <0x03>;
					qcom,latency-us = <0x2b13>;
					label = "system-pc";
					qcom,energy-overhead = <0x96663>;
					qcom,ss-power = <0x154>;
					qcom,is-reset;
					reg = <0x02>;
					qcom,psci-mode = <0x03>;
					qcom,notify-rpm;
					qcom,min-child-idx = <0x03>;
				};
			};
		};

		qcom,msm-dai-tdm-tert-rx {
			compatible = "qcom,msm-dai-tdm";
			qcom,msm-cpudai-tdm-group-port-id = <0x9020>;
			qcom,msm-cpudai-tdm-clk-internal = <0x01>;
			qcom,msm-cpudai-tdm-sync-mode = <0x01>;
			qcom,msm-cpudai-tdm-clk-rate = <0x177000>;
			qcom,msm-cpudai-tdm-data-out = <0x00>;
			qcom,msm-cpudai-tdm-data-delay = <0x01>;
			qcom,msm-cpudai-tdm-group-id = <0x9120>;
			qcom,msm-cpudai-tdm-invert-sync = <0x01>;
			qcom,msm-cpudai-tdm-group-num-ports = <0x01>;
			qcom,msm-cpudai-tdm-sync-src = <0x01>;

			dai_tert_tdm_rx_0: qcom,msm-dai-q6-tdm-tert-rx-0 {
				compatible = "qcom,msm-dai-q6-tdm";
				qcom,msm-cpudai-tdm-dev-id = <0x9020>;
				phandle = <0x2ce>;
				qcom,msm-cpudai-tdm-data-align = <0x00>;
				linux,phandle = <0x2ce>;
			};
		};

		devfreq_spdm_gov {
			compatible = "qcom,gov_spdm_hyp";
			status = "disabled";
			interrupts = <0x00 0xc0 0x00>;
			interrupt-names = "spdm-irq";
		};

		cti13: cti@601d000 {
			compatible = "arm,primecell";
			clocks = <0x29 0x1492202a 0x29 0xdd121669>;
			reg-names = "cti-base";
			coresight-name = "coresight-cti13";
			clock-names = "apb_pclk";
			phandle = <0x238>;
			arm,primecell-periphid = <0x3b966>;
			reg = <0x601d000 0x1000>;
			linux,phandle = <0x238>;
		};

		funnel_in0: funnel@6021000 {
			compatible = "arm,primecell";
			clocks = <0x29 0x1492202a 0x29 0xdd121669>;
			reg-names = "funnel-base";
			coresight-name = "coresight-funnel-in0";
			clock-names = "apb_pclk";
			phandle = <0x220>;
			arm,primecell-periphid = <0x3b908>;
			reg = <0x6021000 0x1000>;
			linux,phandle = <0x220>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {

					funnel_in0_out_tmc_etf: endpoint {
						remote-endpoint = <0x70>;
						phandle = <0x6d>;
						linux,phandle = <0x6d>;
					};
				};

				port@2 {
					reg = <0x06>;

					funnel_in0_in_tpda: endpoint {
						remote-endpoint = <0x72>;
						phandle = <0x9a>;
						slave-mode;
						linux,phandle = <0x9a>;
					};
				};

				port@4 {
					reg = <0x04>;

					funnel_in0_in_funnel_right: endpoint {
						remote-endpoint = <0x74>;
						phandle = <0x79>;
						slave-mode;
						linux,phandle = <0x79>;
					};
				};

				port@1 {
					reg = <0x07>;

					funnel_in0_in_stm: endpoint {
						remote-endpoint = <0x71>;
						phandle = <0x93>;
						slave-mode;
						linux,phandle = <0x93>;
					};
				};

				port@3 {
					reg = <0x03>;

					funnel_in0_in_funnel_center: endpoint {
						remote-endpoint = <0x73>;
						phandle = <0x76>;
						slave-mode;
						linux,phandle = <0x76>;
					};
				};

				port@5 {
					reg = <0x05>;

					funnel_in0_in_funnel_mm: endpoint {
						remote-endpoint = <0x75>;
						phandle = <0x7d>;
						slave-mode;
						linux,phandle = <0x7d>;
					};
				};
			};
		};

		#include "m1822/msm8953-m1822-audio.dtsi"

		adv_vreg: adv_vreg {
			compatible = "regulator-fixed";
			enable-active-high;
			gpio = <0x14d 0x05 0x00>;
			phandle = <0x2af>;
			startup-delay-us = <0x190>;
			regulator-name = "adv_vreg";
			linux,phandle = <0x2af>;
		};
	};

	#include "m1822/msm8953-m1822-symbols.dtsi"

	reserved-memory {
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		ramoops@8f000000 {
			compatible = "ramoops";
			record-size = <0x40000>;
			console-size = <0x80000>;
			ftrace-size = <0x40000>;
			reg = <0x00 0x8f000000 0x00 0x100000>;
		};

		adsp_fw_mem: adsp_fw_region@0 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x13d>;
			reg = <0x00 0x8d600000 0x00 0x1100000>;
			linux,phandle = <0x13d>;
		};

		gpu_mem: gpu_region@0 {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x80000000 0x00 0x10000000>;
			size = <0x00 0x800000>;
			phandle = <0xa6>;
			linux,phandle = <0xa6>;
		};

		dfps_data_mem: dfps_data_mem@90000000 {
			status = "disabled";
			label = "dfps_data_mem";
			phandle = <0xb9>;
			reg = <0x00 0x90000000 0x00 0x1000>;
			linux,phandle = <0xb9>;
		};

		mba_mem: mba_region@0 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x895301>;
			reg = <0x00 0xf3100000 0x00 0x100000>;
			linux,phandle = <0x895301>;
		};

		modem_mem: modem_region@0 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x13a>;
			reg = <0x00 0x86c00000 0x00 0x5b00000>;
			linux,phandle = <0x13a>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			size = <0x00 0x400000>;
			phandle = <0x9f>;
			linux,phandle = <0x9f>;
		};

		qseecom_mem: qseecom_region@0 {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x9e>;
			linux,phandle = <0x9e>;
		};

		cont_splash_mem: splash_region@0x90001000 {
			label = "cont_splash_mem";
			phandle = <0xad>;
			reg = <0x00 0x90001000 0x00 0x13ff000>;
			linux,phandle = <0xad>;
		};

		dump_mem: mem_dump_region {
			reusable;
			compatible = "shared-dma-pool";
			size = <0x400000>;
			phandle = <0x100>;
			linux,phandle = <0x100>;
		};

		wcnss_fw_mem: wcnss_fw_region@0 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x140>;
			reg = <0x00 0x8e700000 0x00 0x700000>;
			linux,phandle = <0x140>;
		};

		adsp_mem: adsp_region@0 {
			reusable;
			compatible = "shared-dma-pool";
			size = <0x00 0x400000>;
			phandle = <0x125>;
			linux,phandle = <0x125>;
		};

		venus_mem: venus_region@0 {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x80000000 0x00 0x10000000>;
			size = <0x00 0x800000>;
			phandle = <0x141>;
			linux,phandle = <0x141>;
		};

		other_ext_mem: other_ext_region@0 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x2df>;
			reg = <0x00 0x84a00000 0x00 0x1e00000>;
			linux,phandle = <0x2df>;
		};

		vm_fw_mem: vm_fw_mem@0 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x2e0>;
			reg = <0x00 0x92a00000 0x00 0x7800000>;
			linux,phandle = <0x2e0>;
		};

		secure_mem: secure_region@0 {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x00 0x400000>;
			size = <0x00 0xb400000>;
			phandle = <0x9d>;
			linux,phandle = <0x9d>;
		};
	};

	#include "m1822/msm8953-m1822-batterydata.dtsi"
};
