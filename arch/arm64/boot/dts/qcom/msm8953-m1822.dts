/dts-v1/;

/ {
	compatible = "qcom,mtp";
	model = "MTP S3 K81822AA1";
	qcom,msm-name = "SDM632";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,msm-id = <0x15d 0x00>;
	qcom,pmic-id = <0x10016 0x25 0x00 0x00>;
	qcom,pmic-name = "PMI632";

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		CPU4: cpu@100 {
			compatible = "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0d 0x0e>;
			next-level-cache = <0x0f>;
			enable-method = "psci";
			phandle = <0x06>;
			reg = <0x00 0x100>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x06>;
			efficiency = <0x666>;

			L1_I_100: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x15>;
				qcom,dump-size = <0x12000>;
				linux,phandle = <0x15>;
			};

			L1_TLB_100: l1-tlb {
				phandle = <0x25>;
				qcom,dump-size = <0x4800>;
				linux,phandle = <0x25>;
			};

			L1_D_100: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1d>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x1d>;
			};

			L2_1: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x0f>;
				linux,phandle = <0x0f>;
			};
		};

		CPU6: cpu@102 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0d 0x0e>;
			next-level-cache = <0x0f>;
			enable-method = "psci";
			phandle = <0x08>;
			reg = <0x00 0x102>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x08>;
			efficiency = <0x666>;

			L1_I_102: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x17>;
				qcom,dump-size = <0x12000>;
				linux,phandle = <0x17>;
			};

			L1_TLB_102: l1-tlb {
				phandle = <0x27>;
				qcom,dump-size = <0x4800>;
				linux,phandle = <0x27>;
			};

			L1_D_102: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1f>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x1f>;
			};
		};

		CPU0: cpu@0 {
			compatible = "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0a 0x0b>;
			next-level-cache = <0x0c>;
			enable-method = "psci";
			phandle = <0x02>;
			reg = <0x00 0x00>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x02>;
			efficiency = <0x400>;

			L1_I_0: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x11>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x11>;
			};

			L1_TLB_0: l1-tlb {
				phandle = <0x21>;
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x21>;
			};

			L1_D_0: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x19>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x19>;
			};

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x0c>;
				qcom,dump-size = <0x00>;
				linux,phandle = <0x0c>;
			};
		};

		CPU2: cpu@2 {
			compatible = "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0a 0x0b>;
			next-level-cache = <0x0c>;
			enable-method = "psci";
			phandle = <0x04>;
			reg = <0x00 0x02>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x04>;
			efficiency = <0x400>;

			L1_I_2: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x13>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x13>;
			};

			L1_TLB_2: l1-tlb {
				phandle = <0x23>;
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x23>;
			};

			L1_D_2: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1b>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x1b>;
			};
		};

		cpu-map {

			cluster0 {

				core2 {
					cpu = <0x04>;
				};

				core1 {
					cpu = <0x03>;
				};

				core3 {
					cpu = <0x05>;
				};

				core0 {
					cpu = <0x02>;
				};
			};

			cluster1 {

				core2 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x07>;
				};

				core3 {
					cpu = <0x09>;
				};

				core0 {
					cpu = <0x06>;
				};
			};
		};

		CPU5: cpu@101 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0d 0x0e>;
			next-level-cache = <0x0f>;
			enable-method = "psci";
			phandle = <0x07>;
			reg = <0x00 0x101>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x07>;
			efficiency = <0x666>;

			L1_I_101: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x16>;
				qcom,dump-size = <0x12000>;
				linux,phandle = <0x16>;
			};

			L1_TLB_101: l1-tlb {
				phandle = <0x26>;
				qcom,dump-size = <0x4800>;
				linux,phandle = <0x26>;
			};

			L1_D_101: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1e>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x1e>;
			};
		};

		CPU7: cpu@103 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0d 0x0e>;
			next-level-cache = <0x0f>;
			enable-method = "psci";
			phandle = <0x09>;
			reg = <0x00 0x103>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x09>;
			efficiency = <0x666>;

			L1_I_103: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x18>;
				qcom,dump-size = <0x12000>;
				linux,phandle = <0x18>;
			};

			L1_TLB_103: l1-tlb {
				phandle = <0x28>;
				qcom,dump-size = <0x4800>;
				linux,phandle = <0x28>;
			};

			L1_D_103: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x20>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x20>;
			};
		};

		CPU1: cpu@1 {
			compatible = "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0a 0x0b>;
			next-level-cache = <0x0c>;
			enable-method = "psci";
			phandle = <0x03>;
			reg = <0x00 0x01>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x03>;
			efficiency = <0x400>;

			L1_I_1: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x12>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x12>;
			};

			L1_TLB_1: l1-tlb {
				phandle = <0x22>;
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x22>;
			};

			L1_D_1: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1a>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x1a>;
			};
		};

		CPU3: cpu@3 {
			compatible = "arm,armv8";
			device_type = "cpu";
			sched-energy-costs = <0x0a 0x0b>;
			next-level-cache = <0x0c>;
			enable-method = "psci";
			phandle = <0x05>;
			reg = <0x00 0x03>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x05>;
			efficiency = <0x400>;

			L1_I_3: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x14>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x14>;
			};

			L1_TLB_3: l1-tlb {
				phandle = <0x24>;
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x24>;
			};

			L1_D_3: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1c>;
				qcom,dump-size = <0x9040>;
				linux,phandle = <0x1c>;
			};
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x10000000 0x00 0x70000000 0x00 0x80000000 0x00 0x80000000>;
	};

	chosen {
		bootargs = "kpti=0 console=ttyMSM0,115200,n8 androidboot.console=ttyMSM0 androidboot.hardware=qcom msm_rtb.filter=0x237 ehci-hcd.park=3 lpm_levels.sleep_disabled=1 androidboot.bootdevice=7824900.sdhci earlycon=msm_serial_dm,0x78af000 buildvariant=user androidboot.emmc=true androidboot.bootreason=hard-reset androidboot.verifiedbootstate=orange androidboot.keymaster=1 androidboot.vbmeta.device=PARTUUID=a4ef1950-da1b-cdbb-c3c6-fdf101db59cf androidboot.vbmeta.avb_version=1.0 androidboot.vbmeta.device_state=unlocked androidboot.vbmeta.hash_alg=sha256 androidboot.vbmeta.size=2240 androidboot.vbmeta.digest=b058b89bf8ea2067828a181bf356c834a3fded39c1219d14f6fb10e8850ff4a1 androidboot.veritymode=enforcing androidboot.serialno=822HEDTS22689 androidboot.efuse=enable printk.kernel_uart_log=disable androidboot.unlocked=1 androidboot.baseband=msm mdss_mdp.panel=1:dsi:0:qcom,mdss_dsi_td4310_csot_fhdp_video:1:none:cfg:single_dsi androidboot.board_id=K81822FA1 board_gpio_num=1 productid=PVT:board_vol=1329076 androidboot.usbst1=0x00 androidboot.selinux=permissive";
		linux,initrd-start = <0x13600000>;
		linux,initrd-end = <0x137879c2>;
		kaslr-seed = <0x00 0x00>;
	};

	aliases {
		i2c3 = "/soc/i2c@78b7000";
		smd8 = "/soc/qcom,smdtty/qcom,smdtty-data4";
		smd36 = "/soc/qcom,smdtty/smdtty-loopback";
		smd6 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-data";
		sdhc2 = "/soc/sdhci@7864900";
		smd4 = "/soc/qcom,smdtty/qcom,smdtty-mbalbridge";
		smd2 = "/soc/qcom,smdtty/smdtty-apps-riva-bt-acl";
		spi3 = "/soc/spi@78b7000";
		i2c2 = "/soc/i2c@78b6000";
		smd7 = "/soc/qcom,smdtty/qcom,smdtty-data1";
		smd5 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-cmd";
		sdhc1 = "/soc/sdhci@7824900";
		smd3 = "/soc/qcom,smdtty/qcom,smdtty-apps-riva-bt-cmd";
		smd1 = "/soc/qcom,smdtty/qcom,smdtty-apps-fm";
		smd21 = "/soc/qcom,smdtty/qcom,smdtty-data21";
		i2c5 = "/soc/i2c@7af5000";
		smd11 = "/soc/qcom,smdtty/qcom,smdtty-data11";
	};

	firmware: firmware {
		phandle = <0x2de>;
		linux,phandle = <0x2de>;

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};

			fstab {
				compatible = "android,fstab";

				system {
					compatible = "android,system";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/system";
					type = "ext4";
					status = "ok";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,discard";
				};

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/vendor";
					type = "ext4";
					status = "ok";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,discard";
				};
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	energy_costs: energy-costs {
		compatible = "sched-energy";
		phandle = <0x2e1>;
		linux,phandle = <0x2e1>;

		CPU_COST_1: core-cost1 {
			idle-cost-data = <0x64 0x50 0x3c 0x28>;
			phandle = <0x0d>;
			busy-cost-data = <0x9ab00 0x2d2 0xdc500 0x507 0x10b300 0x6cb 0x156300 0xb03 0x17bb00 0xdcc 0x1b8a00 0x13ae 0x1e74e0 0x19e0 0x1ec300 0x1a20>;
			linux,phandle = <0x0d>;
		};

		CLUSTER_COST_1: cluster-cost1 {
			idle-cost-data = <0x04 0x03 0x02 0x01>;
			phandle = <0x0e>;
			busy-cost-data = <0x9ab00 0x44 0xdc500 0x67 0x10b300 0x84 0x156300 0xc1 0x17bb00 0xe9 0x1b8a00 0x124 0x1e74e0 0x176 0x1ec300 0x179>;
			linux,phandle = <0x0e>;
		};

		CPU_COST_0: core-cost0 {
			idle-cost-data = <0x14 0x10 0x0c 0x08>;
			phandle = <0x0a>;
			busy-cost-data = <0x96000 0x17 0xd7a00 0x29 0xfd200 0x38 0x14cd00 0x58 0x177000 0x70 0x197d00 0x97 0x1b8a00 0xc2>;
			linux,phandle = <0x0a>;
		};

		CLUSTER_COST_0: cluster-cost0 {
			idle-cost-data = <0x04 0x03 0x02 0x01>;
			phandle = <0x0b>;
			busy-cost-data = <0x96000 0x08 0xd7a00 0x0e 0xfd200 0x12 0x14cd00 0x1c 0x177000 0x23 0x197d00 0x2b 0x1b8a00 0x36>;
			linux,phandle = <0x0b>;
		};
	};

	soc: soc {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0xffffffff>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x1ae>;
		linux,phandle = <0x1ae>;

		dai_tert_auxpcm: qcom,msm-tert-auxpcm {
			qcom,msm-auxpcm-interface = "tertiary";
			compatible = "qcom,msm-auxpcm-dev";
			qcom,msm-cpudai-auxpcm-sync = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-frame = <0x05 0x04>;
			qcom,msm-cpudai-auxpcm-quant = <0x02 0x02>;
			qcom,msm-cpudai-afe-clk-ver = <0x02>;
			qcom,msm-cpudai-auxpcm-slot-mapping = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-num-slots = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-data = <0x00 0x00>;
			qcom,msm-cpudai-auxpcm-pcm-clk-rate = <0x1f4000 0x1f4000>;
			phandle = <0x2c6>;
			qcom,msm-cpudai-auxpcm-mode = <0x00 0x00>;
			linux,phandle = <0x2c6>;
		};

		vfe0: qcom,vfe0@1b10000 {
			qcom,clock-rates = <0x00 0x00 0xfe50fb0 0x00 0x00 0x00 0x00 0x00>;
			vbif-entries = <0x01>;
			ds-entries = <0x11>;
			compatible = "qcom,vfe40";
			clocks = <0x29 0x4e814a78 0x29 0x9894b414 0x29 0xa0c2bd8f 0x29 0xaaa3cd97 0x29 0xcc73453c 0x29 0x4050f47a 0x29 0x77fe2384 0x29 0x3c0a858f>;
			vbif-settings = <0x03>;
			vbif-regs = <0x124>;
			max-clk-nominal = <0x1bb75640>;
			reg-names = "vfe", "vfe_vbif";
			ds-settings = <0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0xcccc1111 0x110>;
			clock-names = "camss_top_ahb_clk", "camss_ahb_clk", "vfe_clk_src", "camss_vfe_vfe_clk", "camss_csi_vfe_clk", "iface_clk", "bus_clk", "iface_ahb_clk";
			ds-regs = <0x988 0x98c 0x990 0x994 0x998 0x99c 0x9a0 0x9a4 0x9a8 0x9ac 0x9b0 0x9b4 0x9b8 0x9bc 0x9c0 0x9c4 0x9c8>;
			qos-entries = <0x08>;
			qos-settings = <0xaa55aa55 0xaa55aa55 0xaa55aa55 0xaa55aa55 0xaa55aa55 0xaa55aa55 0xaa55aa55 0xaa55aa55>;
			max-clk-turbo = <0x1bb75640>;
			interrupts = <0x00 0x39 0x00>;
			phandle = <0x2b2>;
			qos-regs = <0x2c4 0x2c8 0x2cc 0x2d0 0x2d4 0x2d8 0x2dc 0x2e0>;
			vdd-supply = <0x14e>;
			reg = <0x1b10000 0x1000 0x1b40000 0x200>;
			linux,phandle = <0x2b2>;
			interrupt-names = "vfe";
			cell-index = <0x00>;
		};

		qcom,csid@1b30800 {
			qcom,clock-rates = <0x00 0x3ab06a0 0x00 0xbebc200 0x00 0x00 0x00 0x00 0x00>;
			compatible = "qcom,csid-v3.5.1", "qcom,csid";
			clocks = <0x29 0x4e814a78 0x29 0x3c0a858f 0x29 0xf3f25940 0x29 0x4113589f 0x29 0xbeeffbcd 0x29 0xb6857fa2 0x29 0xa619561a 0x29 0x19fd3f1 0x29 0x9894b414>;
			reg-names = "csid";
			clock-names = "camss_top_ahb_clk", "ispif_ahb_clk", "csi_ahb_clk", "csi_src_clk", "csi2_phy_clk", "csi_clk", "csi_pix_clk", "csi_rdi_clk", "camss_ahb_clk";
			qcom,csi-vdd-voltage = <0x12b128>;
			status = "ok";
			interrupts = <0x00 0x99 0x00>;
			reg = <0x1b30800 0x400>;
			interrupt-names = "csid";
			qcom,mipi-csi-vdd-supply = <0xae>;
			cell-index = <0x02>;
		};

		gdsc_vfe1: qcom,gdsc@185806c {
			compatible = "qcom,gdsc";
			clocks = <0x29 0xcaf20d99 0x29 0xaf7463b3 0x29 0xfbbee8cf 0x29 0xb1ef6e8b>;
			clock-names = "core_clk", "bus_clk", "micro_clk", "csi_clk";
			status = "okay";
			phandle = <0x14f>;
			reg = <0x185806c 0x04>;
			regulator-name = "gdsc_vfe1";
			linux,phandle = <0x14f>;
		};

		i2c_2: i2c@78b6000 {
			compatible = "qcom,i2c-msm-v2";
			clocks = <0x29 0x8caa5b4f 0x29 0x1076f220>;
			reg-names = "qup_phys_addr";
			pinctrl-1 = <0x10c>;
			clock-names = "iface_clk", "core_clk";
			qcom,clk-freq-in = <0x124f800>;
			#address-cells = <0x01>;
			interrupts = <0x00 0x60 0x00>;
			#size-cells = <0x00>;
			dma-names = "tx", "rx";
			phandle = <0x267>;
			reg = <0x78b6000 0x600>;
			pinctrl-0 = <0x10b>;
			dmas = <0x10d 0x06 0x40 0x20000020 0x20 0x10d 0x07 0x20 0x20000020 0x20>;
			qcom,clk-freq-out = <0x61a80>;
			linux,phandle = <0x267>;
			interrupt-names = "qup_irq";
			qcom,noise-rjct-scl = <0x00>;
			qcom,noise-rjct-sda = <0x00>;
			pinctrl-names = "i2c_active", "i2c_sleep";
			qcom,master-id = <0x56>;

			aw87329@58 {
				reset-gpio = <0xc3 0x60 0x00>;
				compatible = "awinic,aw87329_pa";
				status = "okay";
				reg = <0x58>;
			};
		};

		clock_gcc_gfx: qcom,gcc-gfx@1800000 {
			compatible = "qcom,gcc-gfx-sdm632";
			clocks = <0x29 0x23f5649f>;
			reg-names = "cc_base";
			clock-names = "xo";
			vdd_gfx-supply = <0x11c>;
			#clock-cells = <0x01>;
