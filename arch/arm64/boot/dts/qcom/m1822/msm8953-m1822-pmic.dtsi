				pm8953_gpios: gpios {
					compatible = "qcom,spmi-gpio";
					gpio-controller;
					qcom,gpios-disallowed = <0x03 0x06>;
					interrupts = <0x00 0xc0 0x00 0x00 0x00 0xc1 0x00 0x00 0x00 0xc3 0x00 0x00 0x00 0xc4 0x00 0x00 0x00 0xc6 0x00 0x00 0x00 0xc7 0x00 0x00>;
