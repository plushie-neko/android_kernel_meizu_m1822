		spmi_bus: qcom,spmi@200f000 {
			compatible = "qcom,spmi-pmic-arb";
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			qcom,channel = <0x00>;
			#interrupt-cells = <0x04>;
			#address-cells = <0x01>;
			interrupts = <0x00 0xbe 0x00>;
			#size-cells = <0x01>;
			phandle = <0x127>;
			qcom,ee = <0x00>;
			reg = <0x200f000 0x1000 0x2400000 0x800000 0x2c00000 0x800000 0x3800000 0x200000 0x200a000 0x2100>;
			linux,phandle = <0x127>;
			interrupt-names = "periph_irq";
			cell-index = <0x00>;
			interrupt-controller;

			pmi632_3: qcom,pmi632@3 {
				compatible = "qcom,spmi-pmic";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				phandle = <0x2a4>;
				reg = <0x03 0x00>;
				linux,phandle = <0x2a4>;

				pmi632_lcdb: qpnp-lcdb@ec00 {
					compatible = "qcom,qpnp-lcdb-regulator";
					qcom,pmic-revid = <0x12c>;
					#address-cells = <0x01>;
					interrupts = <0x03 0xec 0x01 0x01>;
					#size-cells = <0x01>;
					phandle = <0x2a7>;
					reg = <0xec00 0x100>;
					linux,phandle = <0x2a7>;
					interrupt-names = "sc-irq";

					lcdb_ncp_vreg: ncp {
						label = "ncp";
						phandle = <0x2a9>;
						regulator-min-microvolt = <0x588040>;
						regulator-max-microvolt = <0x588040>;
						regulator-name = "lcdb_ncp";
						linux,phandle = <0x2a9>;
						qcom,ncp-ilim-ma = <0x104>;
					};

					lcdb_ldo_vreg: ldo {
						qcom,ldo-ilim-ma = <0x104>;
						label = "ldo";
						phandle = <0x2a8>;
						regulator-min-microvolt = <0x588040>;
						regulator-max-microvolt = <0x588040>;
						regulator-name = "lcdb_ldo";
						linux,phandle = <0x2a8>;
					};
				};

				pmi632_vib: qcom,vibrator@5700 {
					compatible = "qcom,qpnp-vibrator-ldo";
					qcom,disable-overdrive;
					phandle = <0x2a5>;
					reg = <0x5700 0x100>;
					linux,phandle = <0x2a5>;
					qcom,vib-ldo-volt-uv = <0x2dc6c0>;
				};

				flash_led: qcom,leds@d300 {
					qcom,vph-droop-det;
					compatible = "qcom,qpnp-flash-led-v2";
					qcom,thermal-derate-current = <0xc8 0x1f4 0x3e8>;
					qcom,open-circuit-det;
					qcom,pmic-revid = <0x12c>;
					qcom,isc-delay = <0xc0>;
					qcom,short-circuit-det;
					status = "okay";
					interrupts = <0x03 0xd3 0x00 0x01 0x03 0xd3 0x03 0x01 0x03 0xd3 0x04 0x01>;
					label = "flash";
					qcom,thermal-derate-en;
					phandle = <0x2aa>;
					reg = <0xd300 0x100>;
					linux,phandle = <0x2aa>;
					interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";

					pmi632_switch0: qcom,led_switch_0 {
						qcom,led-name = "led:switch_0";
						qcom,led-mask = <0x03>;
						qcom,default-led-trigger = "switch0_trigger";
						label = "switch";
						phandle = <0x1ad>;
						linux,phandle = <0x1ad>;
					};

					pmi632_torch0: qcom,torch_0 {
						qcom,led-name = "led:torch_0";
						qcom,id = <0x00>;
						qcom,hdrm-voltage-mv = <0x190>;
						qcom,default-led-trigger = "torch0_trigger";
						label = "torch";
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,max-current = <0x1f4>;
						phandle = <0x1ab>;
						qcom,ires-ua = <0x30d4>;
						qcom,current-ma = <0x12c>;
						linux,phandle = <0x1ab>;
					};

					pmi632_flash1: qcom,flash_1 {
						qcom,led-name = "led:flash_1";
						qcom,id = <0x01>;
						qcom,hdrm-voltage-mv = <0x190>;
						qcom,duration-ms = <0x500>;
						qcom,default-led-trigger = "flash1_trigger";
						label = "flash";
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,max-current = <0x5dc>;
						phandle = <0x1aa>;
						qcom,ires-ua = <0x30d4>;
						qcom,current-ma = <0x3e8>;
						linux,phandle = <0x1aa>;
					};

					pmi632_switch1: qcom,led_switch_1 {
						qcom,led-name = "led:switch_1";
						qcom,led-mask = <0x02>;
						qcom,default-led-trigger = "switch1_trigger";
						label = "switch";
						phandle = <0x2ab>;
						linux,phandle = <0x2ab>;
					};

					pmi632_flash0: qcom,flash_0 {
						qcom,led-name = "led:flash_0";
						qcom,id = <0x00>;
						qcom,hdrm-voltage-mv = <0x190>;
						qcom,duration-ms = <0x500>;
						qcom,default-led-trigger = "flash0_trigger";
						label = "flash";
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,max-current = <0x5dc>;
						phandle = <0x1a9>;
						qcom,ires-ua = <0x30d4>;
						qcom,current-ma = <0x3e8>;
						linux,phandle = <0x1a9>;
					};

					pmi632_torch1: qcom,torch_1 {
						qcom,led-name = "led:torch_1";
						qcom,id = <0x01>;
						qcom,hdrm-voltage-mv = <0x190>;
						qcom,default-led-trigger = "torch1_trigger";
						label = "torch";
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,max-current = <0x1f4>;
						phandle = <0x1ac>;
						qcom,ires-ua = <0x30d4>;
						qcom,current-ma = <0x12c>;
						linux,phandle = <0x1ac>;
					};
				};

				pmi632_rgb: qcom,leds@d000 {
					compatible = "qcom,tri-led";
					phandle = <0x2a6>;
					reg = <0xd000 0x100>;
					linux,phandle = <0x2a6>;

					mx-led {
						label = "mx-led";
						led-sources = <0x00>;
						pwms = <0x131 0x00 0xf4240>;
					};
				};

				pmi632_pwm: qcom,pwms@b300 {
					compatible = "qcom,pwm-lpg";
					qcom,lut-sdam-base = <0x80>;
					reg-names = "lpg-base";
					nvmem-names = "ppg_sdam";
					qcom,lut-patterns = <0x00 0x00 0x00 0x0e 0x1c 0x2a 0x38 0x46 0x54 0x64 0x64 0x54 0x46 0x38 0x2a 0x1c 0x0e 0x00 0x00 0x00>;
					phandle = <0x131>;
					qcom,pbs-client = <0x130>;
					reg = <0xb300 0x500>;
					nvmem = <0x12f>;
					linux,phandle = <0x131>;
					#pwm-cells = <0x02>;

					lpg@1 {
						qcom,lpg-sdam-base = <0x48>;
						qcom,ramp-pattern-repeat;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-low-index = <0x00>;
						qcom,lpg-chan-id = <0x01>;
						qcom,ramp-step-ms = <0xc8>;
					};

					lpg@3 {
						qcom,lpg-sdam-base = <0x64>;
						qcom,ramp-pattern-repeat;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-low-index = <0x00>;
						qcom,lpg-chan-id = <0x03>;
						qcom,ramp-step-ms = <0xc8>;
					};

					lpg@2 {
						qcom,lpg-sdam-base = <0x56>;
						qcom,ramp-pattern-repeat;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-low-index = <0x00>;
						qcom,lpg-chan-id = <0x02>;
						qcom,ramp-step-ms = <0xc8>;
					};
				};
			};

			pm8953_1: qcom,pm8953@1 {
				compatible = "qcom,spmi-pmic";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				phandle = <0x29e>;
				reg = <0x01 0x00>;
				linux,phandle = <0x29e>;

				pm8953_pwm: qcom,pwms@bc00 {
					compatible = "qcom,pwm-lpg";
					reg-names = "lpg-base";
					status = "ok";
					phandle = <0x29f>;
					reg = <0xbc00 0x100>;
					qcom,supported-sizes = <0x06 0x09>;
					linux,phandle = <0x29f>;
					#pwm-cells = <0x02>;
				};

				pmic_analog_codec: analog-codec@f000 {
					qcom,cdc-vdd-io-voltage = <0x1b7740 0x1b7740>;
					qcom,cdc-on-demand-supplies = "cdc-vdd-mic-bias";
					cdc-vdda-cp-supply = <0x128>;
					compatible = "qcom,pmic-analog-codec";
					qcom,cdc-vdda-cp-current = <0x7a120>;
					qcom,cdc-static-supplies = "cdc-vdd-io", "cdc-vdd-pa", "cdc-vdda-cp";
					qcom,cdc-vdd-mic-bias-current = <0x1388>;
					qcom,cdc-vdda-cp-voltage = <0x1cfde0 0x1f47d0>;
					status = "okay";
					interrupt-parent = <0x127>;
					#address-cells = <0x02>;
					interrupts = <0x01 0xf0 0x00 0x00 0x01 0xf0 0x01 0x00 0x01 0xf0 0x02 0x00 0x01 0xf0 0x03 0x00 0x01 0xf0 0x04 0x00 0x01 0xf0 0x05 0x00 0x01 0xf0 0x06 0x00 0x01 0xf0 0x07 0x00 0x01 0xf1 0x00 0x00 0x01 0xf1 0x01 0x00 0x01 0xf1 0x02 0x00 0x01 0xf1 0x03 0x00 0x01 0xf1 0x04 0x00 0x01 0xf1 0x05 0x00>;
					qcom,cdc-mclk-clk-rate = <0x927c00>;
					qcom,cdc-vdd-pa-current = <0x3f7a0>;
					#size-cells = <0x00>;
					cdc-vdd-io-supply = <0xb3>;
					phandle = <0x183>;
					qcom,cdc-vdd-io-current = <0x1388>;
					reg = <0xf000 0x200>;
					qcom,cdc-vdd-mic-bias-voltage = <0x2faf08 0x2faf08>;
					cdc-vdd-mic-bias-supply = <0x11a>;
					qcom,cdc-vdd-pa-voltage = <0x1cfde0 0x1f47d0>;
					linux,phandle = <0x183>;
					interrupt-names = "spk_cnp_int", "spk_clip_int", "spk_ocp_int", "ins_rem_det1", "but_rel_det", "but_press_det", "ins_rem_det", "mbhc_int", "ear_ocp_int", "hphr_ocp_int", "hphl_ocp_det", "ear_cnp_int", "hphr_cnp_int", "hphl_cnp_int";
					cdc-vdd-pa-supply = <0x128>;

					msm_digital_codec: msm-dig-codec {
						compatible = "qcom,msm-digital-codec";
						phandle = <0x182>;
						reg = <0xc0f0000 0x00>;
						linux,phandle = <0x182>;
					};
				};

				pm8953_s5: spm-regulator@2000 {
					compatible = "qcom,spm-regulator";
					phandle = <0x149>;
					regulator-min-microvolt = <0x61a80>;
					reg = <0x2000 0x100>;
					regulator-max-microvolt = <0x116520>;
					regulator-name = "pm8953_s5";
					linux,phandle = <0x149>;

					pm8953_s5_limit: avs-limit-regulator {
						phandle = <0x14a>;
						regulator-min-microvolt = <0x61a80>;
						regulator-max-microvolt = <0x116520>;
						regulator-name = "pm8953_s5_avs_limit";
						linux,phandle = <0x14a>;
					};
				};
			};

			qcom,pmi632@2 {
				compatible = "qcom,spmi-pmic";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				reg = <0x02 0x00>;

				pmi632_adc_tm: vadc@3500 {
					qcom,adc-vdd-reference = <0x753>;
					compatible = "qcom,qpnp-adc-tm-hc", "qcom,qpnp-adc-tm-hc-pm5";
					qcom,decimation = <0x00>;
					#thermal-sensor-cells = <0x01>;
					qcom,fast-avg-setup = <0x00>;
					qcom,adc_tm-vadc = <0x12b>;
					#address-cells = <0x01>;
					interrupts = <0x02 0x35 0x00 0x01>;
					#size-cells = <0x00>;
					phandle = <0xde>;
					qcom,adc-full-scale-code = <0x70e4>;
					reg = <0x3500 0x100>;
					linux,phandle = <0xde>;
					interrupt-names = "eoc-int-en-set";

					chan@53 {
						qcom,thermal-node;
						qcom,btm-channel-number = <0x60>;
						qcom,calibration-type = "ratiometric";
						qcom,hw-settle-time = <0x00>;
						qcom,pre-div-channel-scaling = <0x00>;
						label = "quiet_therm";
						reg = <0x53>;
						qcom,scale-function = <0x02>;
					};
				};

				pmi632_charger: qcom,qpnp-smb5 {
					qcom,battery-data = <0x12e>;
					qcom,thermal-mitigation = <0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0xf4240 0x7a120>;
					compatible = "qcom,qpnp-smb5";
					qcom,auto-recharge-soc = <0x63>;
					qcom,pmic-revid = <0x12c>;
					qcom,float-option = <0x01>;
					qcom,usb-icl-ua = <0x1e8480>;
					qcom,chg-vadc = <0x12b>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					qcom,flash-disable-soc = <0x05>;
					phandle = <0xe4>;
					dpdm-supply = <0x12d>;
					qcom,board_temp-vadc = <0x12b>;
					#cooling-cells = <0x02>;
					qcom,connector-internal-pull-kohm = <0x64>;
					linux,phandle = <0xe4>;
					qcom,usbio-vadc = <0x12b>;

					qcom,dcdc@1100 {
						interrupts = <0x02 0x11 0x00 0x01 0x02 0x11 0x01 0x01 0x02 0x11 0x02 0x01 0x02 0x11 0x03 0x03 0x02 0x11 0x04 0x03 0x02 0x11 0x05 0x03 0x02 0x11 0x06 0x01 0x02 0x11 0x07 0x03>;
						reg = <0x1100 0x100>;
						interrupt-names = "otg-fail", "otg-oc-disable-sw", "otg-oc-hiccup", "bsm-active", "high-duty-cycle", "input-current-limiting", "concurrent-mode-disable", "switcher-power-ok";
					};

					qcom,usb@1300 {
						interrupts = <0x02 0x13 0x00 0x03 0x02 0x13 0x01 0x03 0x02 0x13 0x02 0x01 0x02 0x13 0x03 0x03 0x02 0x13 0x04 0x03 0x02 0x13 0x05 0x03 0x02 0x13 0x06 0x01 0x02 0x13 0x07 0x01>;
						reg = <0x1300 0x100>;
						interrupt-names = "usbin-collapse", "usbin-vashdn", "usbin-uv", "usbin-ov", "usbin-plugin", "usbin-revi-change", "usbin-src-change", "usbin-icl-change";
					};

					qcom,typec@1500 {
						interrupts = <0x02 0x15 0x00 0x03 0x02 0x15 0x01 0x03 0x02 0x15 0x02 0x01 0x02 0x15 0x03 0x01 0x02 0x15 0x04 0x03 0x02 0x15 0x05 0x01 0x02 0x15 0x06 0x01 0x02 0x15 0x07 0x01>;
						reg = <0x1500 0x100>;
						interrupt-names = "typec-or-rid-detect-change", "typec-vpd-detect", "typec-cc-state-change", "typec-vconn-oc", "typec-vbus-change", "typec-attach-detach", "typec-legacy-cable-detect", "typec-try-snk-src-detect";
					};

					qcom,schgm-flash@a600 {
						interrupts = <0x02 0xa6 0x02 0x01 0x02 0xa6 0x05 0x01 0x02 0xa6 0x06 0x01 0x02 0xa6 0x07 0x03>;
						qcom,flash-disable-soc = <0x0a>;
						reg = <0xa600 0x100>;
						interrupt-names = "flash-state-change", "ilim1-s1", "ilim2-s2", "vreg-ok";
					};

					qcom,misc@1600 {
						interrupts = <0x02 0x16 0x00 0x01 0x02 0x16 0x01 0x01 0x02 0x16 0x02 0x01 0x02 0x16 0x03 0x01 0x02 0x16 0x04 0x03 0x02 0x16 0x05 0x01 0x02 0x16 0x06 0x01 0x02 0x16 0x07 0x01>;
						reg = <0x1600 0x100>;
						interrupt-names = "wdog-snarl", "wdog-bark", "aicl-fail", "aicl-done", "smb-en", "imp-trigger", "temp-change", "temp-change-smb";
					};

					smb5_vbus: qcom,smb5-vbus {
						phandle = <0x134>;
						regulator-name = "smb5-vbus";
						linux,phandle = <0x134>;
					};

					qcom,chgr@1000 {
						interrupts = <0x02 0x10 0x00 0x01 0x02 0x10 0x01 0x01 0x02 0x10 0x02 0x01 0x02 0x10 0x03 0x01 0x02 0x10 0x04 0x01 0x02 0x10 0x05 0x01 0x02 0x10 0x06 0x01 0x02 0x10 0x07 0x01>;
						reg = <0x1000 0x100>;
						interrupt-names = "chgr-error", "chg-state-change", "step-chg-state-change", "step-chg-soc-update-fail", "step-chg-soc-update-req", "fg-fvcal-qualified", "vph-alarm", "vph-drop-prechg";
					};

					qcom,batif@1200 {
						interrupts = <0x02 0x12 0x00 0x01 0x02 0x12 0x01 0x01 0x02 0x12 0x02 0x03 0x02 0x12 0x03 0x03 0x02 0x12 0x04 0x03 0x02 0x12 0x05 0x03 0x02 0x12 0x06 0x03 0x02 0x12 0x07 0x03>;
						reg = <0x1200 0x100>;
						interrupt-names = "bat-temp", "all-chnl-conv-done", "bat-ov", "bat-low", "bat-therm-or-id-missing", "bat-terminal-missing", "buck-oc", "vph-ov";
					};
				};

				pmi632_pbs_client3: qcom,pbs@7400 {
					compatible = "qcom,qpnp-pbs";
					phandle = <0x130>;
					reg = <0x7400 0x100>;
					linux,phandle = <0x130>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0xf2>;
					linux,phandle = <0xf2>;
				};

				pmi632_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,qpnp-temp-alarm";
					#thermal-sensor-cells = <0x00>;
					interrupts = <0x02 0x24 0x00 0x01>;
					label = "pmi632_tz";
					phandle = <0xf4>;
					reg = <0x2400 0x100>;
					linux,phandle = <0xf4>;
				};

				pmi632_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					gpio-controller;
					qcom,gpios-disallowed = <0x01>;
					interrupts = <0x02 0xc1 0x00 0x00 0x02 0xc2 0x00 0x00 0x02 0xc3 0x00 0x00 0x02 0xc4 0x00 0x00 0x02 0xc5 0x00 0x00 0x02 0xc6 0x00 0x00 0x02 0xc7 0x00 0x00>;
					phandle = <0x2a1>;
					reg = <0xc000 0x800>;
					#gpio-cells = <0x02>;
					linux,phandle = <0x2a1>;
					interrupt-names = "pmi632_gpio2", "pmi632_gpio3", "pmi632_gpio4", "pmi632_gpio5", "pmi632_gpio6", "pmi632_gpio7", "pmi632_gpio8";

					quiet_therm {

						quiet_therm_default: quiet_therm_default {
							pins = "gpio3";
							phandle = <0x129>;
							bias-high-impedance;
							linux,phandle = <0x129>;
						};
					};

					typec_therm {

						typec_therm_default: typec_therm_default {
							pins = "gpio1";
							phandle = <0x2a2>;
							bias-high-impedance;
							linux,phandle = <0x2a2>;
						};
					};

					smb_therm {

						smb_therm_default: smb_therm_default {
							pins = "gpio8";
							phandle = <0x12a>;
							bias-high-impedance;
							linux,phandle = <0x12a>;
						};
					};
				};

				pmi632_sdam7: qcom,sdam@b600 {
					compatible = "qcom,spmi-sdam";
					phandle = <0x12f>;
					reg = <0xb600 0x100>;
					linux,phandle = <0x12f>;
				};

				pmi632_qg: qpnp,qg {
					qcom,hold-soc-while-full;
					qcom,battery-data = <0x12e>;
					compatible = "qcom,qpnp-qg";
					qcom,pmic-revid = <0x12c>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x2a3>;
					qcom,qg-vadc = <0x12b>;
					qcom,qg-iterm-ma = <0xc8>;
					linux,phandle = <0x2a3>;
					qcom,linearize-soc;

					qcom,qgauge@4800 {
						status = "okay";
						interrupts = <0x02 0x48 0x00 0x03 0x02 0x48 0x01 0x03 0x02 0x48 0x02 0x01 0x02 0x48 0x03 0x01 0x02 0x48 0x04 0x01>;
