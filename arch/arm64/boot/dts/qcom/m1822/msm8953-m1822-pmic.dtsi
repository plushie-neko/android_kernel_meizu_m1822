					interrupt-names = "pm8953_gpio1", "pm8953_gpio2", "pm8953_gpio4", "pm8953_gpio5", "pm8953_gpio7", "pm8953_gpio8";

					gpio@c000 {
						qcom,pull = <0x05>;
						status = "ok";
						qcom,src-sel = <0x02>;
						qcom,mode = <0x01>;
						qcom,master-en = <0x01>;
						qcom,vin-sel = <0x00>;
