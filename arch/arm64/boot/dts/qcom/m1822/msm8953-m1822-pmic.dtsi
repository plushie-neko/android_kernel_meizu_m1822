						bklt_en_default: bklt_en_default {
							pins = "gpio8";
							phandle = <0x29b>;
							function = "normal";
							power-source = <0x00>;
							linux,phandle = <0x29b>;
							output-high;
						};
					};

					tasha_mclk {

						tasha_mclk_default: tasha_mclk_default {
							output-low;
							pins = "gpio1";
							bias-disable;
							phandle = <0x1a3>;
							function = "func1";
							power-source = <0x00>;
							linux,phandle = <0x1a3>;
							qcom,drive-strength = <0x02>;
						};
					};

					nfc_clk {

						nfc_clk_default {
							pins = "gpio2";
							phandle = <0x2e7>;
							function = "normal";
							power-source = <0x01>;
							input-enable;
							linux,phandle = <0x2e7>;
						};
					};
				};
			};
		};
