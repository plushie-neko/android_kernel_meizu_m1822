					qcom,pon-dbc-delay = <0x3d09>;
					interrupts = <0x00 0x08 0x00 0x00 0x00 0x08 0x01 0x00 0x00 0x08 0x04 0x00 0x00 0x08 0x05 0x00>;
					reg = <0x800 0x100>;
					interrupt-names = "kpdpwr", "resin", "resin-bark", "kpdpwr-resin-bark";
					qcom,store-hard-reset-reason;

					qcom,pon_2 {
						qcom,pull-up = <0x01>;
						qcom,pon-type = <0x01>;
						linux,code = <0x72>;
					};

					qcom,pon_1 {
						qcom,s2-type = <0x07>;
						qcom,s1-timer = <0x1a40>;
						qcom,support-reset = <0x01>;
						qcom,pull-up = <0x01>;
						qcom,s2-timer = <0x3e8>;
						qcom,pon-type = <0x00>;
						linux,code = <0x74>;
					};
