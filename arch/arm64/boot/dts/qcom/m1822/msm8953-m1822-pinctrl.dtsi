				qdsd_data3_trace: data3_trace {
					phandle = <0x203>;
					linux,phandle = <0x203>;

					config {
						pins = "qdsd_data3";
						drive-strength = <0x08>;
						bias-pull-down;
					};
				};

				qdsd_data3_sdcard: data3_sdcard {
					phandle = <0x202>;
