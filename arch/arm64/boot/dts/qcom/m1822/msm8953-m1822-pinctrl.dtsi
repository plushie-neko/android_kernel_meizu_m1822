					};
				};

				cdc_pdm_comp_lines_sus: pdm_comp_lines_off {
					phandle = <0x187>;
					linux,phandle = <0x187>;

					mux {
						pins = "gpio67", "gpio68";
						function = "cdc_pdm0";
					};

					config {
						pins = "gpio67", "gpio68";
