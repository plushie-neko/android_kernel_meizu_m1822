						pins = "qdsd_data2";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				qdsd_data2_jtag: data2_jtag {
					phandle = <0x201>;
					linux,phandle = <0x201>;

					config {
						pins = "qdsd_data2";
						drive-strength = <0x08>;
						bias-pull-up;
					};
				};

				qdsd_data2_swdtrc: data2_swdtrc {
					phandle = <0x200>;
					linux,phandle = <0x200>;

