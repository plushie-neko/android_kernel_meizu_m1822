					linux,phandle = <0x207>;

					config {
						pins = "qdsd_data3";
						drive-strength = <0x08>;
						bias-pull-down;
					};
				};

				qdsd_data3_swduart: data3_uart {
					phandle = <0x204>;
					linux,phandle = <0x204>;

					config {
						pins = "qdsd_data3";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};

				qdsd_data3_jtag: data3_jtag {
					phandle = <0x206>;
					linux,phandle = <0x206>;

					config {
						pins = "qdsd_data3";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};

				qdsd_data3_swdtrc: data3_swdtrc {
					phandle = <0x205>;
