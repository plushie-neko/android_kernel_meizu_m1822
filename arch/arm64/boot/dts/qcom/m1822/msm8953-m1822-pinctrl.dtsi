				};
			};

			wcnss_pmux_gpio: wcnss_pmux_gpio {
				phandle = <0x1de>;
				linux,phandle = <0x1de>;

				wcnss_gpio_default: wcnss_gpio_default {
					phandle = <0x146>;
					linux,phandle = <0x146>;

					mux {
						pins = "gpio76", "gpio77", "gpio78", "gpio79", "gpio80";
						function = "gpio";
					};

					config {
