				};
			};

			i2c_3 {

				i2c_3_sleep: i2c_3_sleep {
					phandle = <0x10f>;
					linux,phandle = <0x10f>;

					mux {
						pins = "gpio10", "gpio11";
						function = "gpio";
					};

					config {
						pins = "gpio10", "gpio11";
						bias-disable;
						drive-strength = <0x02>;
					};
				};

				i2c_3_active: i2c_3_active {
					phandle = <0x10e>;
					linux,phandle = <0x10e>;

					mux {
						pins = "gpio10", "gpio11";
						function = "blsp_i2c3";
					};

					config {
						pins = "gpio10", "gpio11";
						bias-disable;
						drive-strength = <0x02>;
					};
				};
			};
		};
