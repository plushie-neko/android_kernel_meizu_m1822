		tlmm: pinctrl@1000000 {
			interrupts-extended = <0x01 0x00 0xd0 0x00>;
			compatible = "qcom,msm8953-pinctrl";
			gpio-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x10>;
			interrupts = <0x00 0xd0 0x00>;
			phandle = <0xc3>;
			reg = <0x1000000 0x300000>;
			#gpio-cells = <0x02>;
			linux,phandle = <0xc3>;
			interrupt-controller;

			wsa_clk {

				wsa_clk_on: wsa_clk_on {
					phandle = <0x192>;
					linux,phandle = <0x192>;

					mux {
						pins = "gpio25";
						function = "pri_mi2s_mclk_a";
					};

					config {
						pins = "gpio25";
						drive-strength = <0x08>;
						output-high;
					};
				};

				wsa_clk_off: wsa_clk_off {
					phandle = <0x193>;
					linux,phandle = <0x193>;

					mux {
						pins = "gpio25";
						function = "pri_mi2s_mclk_a";
					};

					config {
						output-low;
						pins = "gpio25";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			cdc-pdm-lines {

				cdc_pdm_lines_act: pdm_lines_on {
					phandle = <0x188>;
					linux,phandle = <0x188>;

					mux {
						pins = "gpio69", "gpio73", "gpio74";
						function = "cdc_pdm0";
					};

					config {
						pins = "gpio69", "gpio73", "gpio74";
						drive-strength = <0x08>;
					};
				};

				cdc_pdm_lines_sus: pdm_lines_off {
					phandle = <0x18a>;
					linux,phandle = <0x18a>;

					mux {
						pins = "gpio69", "gpio73", "gpio74";
						function = "cdc_pdm0";
					};

					config {
						pins = "gpio69", "gpio73", "gpio74";
						bias-disable;
						drive-strength = <0x02>;
					};
				};
			};

			sdc1_cmd_on: sdc1_cmd_on {
				phandle = <0x1cb>;
				linux,phandle = <0x1cb>;

				config {
					pins = "sdc1_cmd";
					drive-strength = <0x0a>;
					bias-pull-up;
				};
			};

			pmx_qdsd_cmd {

				qdsd_cmd_trace: cmd_trace {
					phandle = <0x1ed>;
					linux,phandle = <0x1ed>;

					config {
						pins = "qdsd_cmd";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				qdsd_cmd_spmi: cmd_spmi {
					phandle = <0x1f1>;
					linux,phandle = <0x1f1>;

					config {
						pins = "qdsd_cmd";
						drive-strength = <0x0a>;
						bias-pull-down;
					};
				};

				qdsd_cmd_swdtrc: cmd_swdtrc {
					phandle = <0x1ef>;
					linux,phandle = <0x1ef>;

					config {
						pins = "qdsd_cmd";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};

				qdsd_cmd_sdcard: cmd_sdcard {
					phandle = <0x1ec>;
					linux,phandle = <0x1ec>;

					config {
						pins = "qdsd_cmd";
						drive-strength = <0x08>;
						bias-pull-down;
					};
				};

				qdsd_cmd_swduart: cmd_uart {
					phandle = <0x1ee>;
					linux,phandle = <0x1ee>;

					config {
						pins = "qdsd_cmd";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};

				qdsd_cmd_jtag: cmd_jtag {
					phandle = <0x1f0>;
					linux,phandle = <0x1f0>;

					config {
						pins = "qdsd_cmd";
						bias-disable;
						drive-strength = <0x08>;
					};
				};
			};

			sdc2_cd_off: cd_off {
				phandle = <0x1d8>;
				linux,phandle = <0x1d8>;

				mux {
					pins = "gpio133";
					function = "gpio";
				};

				config {
					pins = "gpio133";
					bias-disable;
					drive-strength = <0x02>;
				};
			};

			cam_sensor_front1_default: cam_sensor_front1_default {
				phandle = <0x1bf>;
				linux,phandle = <0x1bf>;

				mux {
					pins = "gpio129", "gpio130";
					function = "gpio";
				};

				config {
					pins = "gpio129", "gpio130";
					bias-disable;
					drive-strength = <0x02>;
				};
			};

			sdc2_cd_on: cd_on {
				phandle = <0x1d7>;
				linux,phandle = <0x1d7>;

				mux {
					pins = "gpio133";
					function = "gpio";
				};

				config {
					pins = "gpio133";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			hsuart_sleep: sleep {
				phandle = <0x102>;
				linux,phandle = <0x102>;

				mux {
					pins = "gpio12", "gpio13", "gpio14", "gpio15";
					function = "gpio";
				};

				config {
					pins = "gpio12", "gpio13", "gpio14", "gpio15";
					bias-disable;
					drive-strength = <0x02>;
				};
			};

			cam_sensor_mclk2_sleep: cam_sensor_mclk2_sleep {
				phandle = <0x1be>;
				linux,phandle = <0x1be>;

				mux {
					pins = "gpio28";
					function = "cam_mclk";
				};

				config {
					pins = "gpio28";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};

			i2c_5 {

				i2c_5_active: i2c_5_active {
					phandle = <0x113>;
					linux,phandle = <0x113>;

					mux {
						pins = "gpio18", "gpio19";
						function = "blsp_i2c5";
					};

					config {
						pins = "gpio18", "gpio19";
						bias-disable;
						drive-strength = <0x02>;
					};
				};

				i2c_5_sleep: i2c_5_sleep {
					phandle = <0x114>;
					linux,phandle = <0x114>;

					mux {
						pins = "gpio18", "gpio19";
						function = "gpio";
					};

					config {
						pins = "gpio18", "gpio19";
						bias-disable;
						drive-strength = <0x02>;
					};
				};
			};

			pmx-uartconsole {

				uart1_console_sleep: uart1_console_sleep {
					phandle = <0x1b2>;
					linux,phandle = <0x1b2>;

					mux {
						pins = "gpio20", "gpio21";
						function = "blsp_uart6";
					};

					config {
						pins = "gpio20", "gpio21";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				uart1_console_active: uart1_console_active {
					phandle = <0x1b1>;
					linux,phandle = <0x1b1>;

					mux {
						pins = "gpio20", "gpio21";
						function = "blsp_uart6";
					};

					config {
						pins = "gpio20", "gpio21";
						bias-disable;
						drive-strength = <0x02>;
					};
				};

				uart_console_sleep: uart_console_sleep {
					phandle = <0x1b0>;
					linux,phandle = <0x1b0>;

					mux {
						pins = "gpio4", "gpio5";
						function = "blsp_uart2";
					};

					config {
						pins = "gpio4", "gpio5";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				uart_console_active: uart_console_active {
					phandle = <0x1af>;
					linux,phandle = <0x1af>;

					mux {
						pins = "gpio4", "gpio5";
						function = "blsp_uart2";
					};

					config {
						pins = "gpio4", "gpio5";
						bias-disable;
						drive-strength = <0x02>;
					};
				};
			};

			wcnss_pmux_5wire {

				wcnss_default: wcnss_default {
					phandle = <0x144>;
					linux,phandle = <0x144>;

					wcss_wlan {
						pins = "gpio79", "gpio80";
						function = "wcss_wlan";
					};

					wcss_wlan1 {
						pins = "gpio77";
						function = "wcss_wlan1";
					};

					config {
						pins = "gpio76", "gpio77", "gpio78", "gpio79", "gpio80";
						drive-strength = <0x06>;
						bias-pull-up;
					};

					wcss_wlan0 {
						pins = "gpio78";
						function = "wcss_wlan0";
					};

					wcss_wlan2 {
						pins = "gpio76";
						function = "wcss_wlan2";
					};
				};

				wcnss_sleep: wcnss_sleep {
					phandle = <0x145>;
					linux,phandle = <0x145>;

					wcss_wlan {
						pins = "gpio79", "gpio80";
						function = "wcss_wlan";
					};

					wcss_wlan1 {
						pins = "gpio77";
						function = "wcss_wlan1";
					};

					config {
						pins = "gpio76", "gpio77", "gpio78", "gpio79", "gpio80";
						drive-strength = <0x02>;
						bias-pull-down;
					};

					wcss_wlan0 {
						pins = "gpio78";
						function = "wcss_wlan0";
					};

					wcss_wlan2 {
						pins = "gpio76";
						function = "wcss_wlan2";
					};
				};
			};

			sdc2_data_off: sdc2_data_off {
				phandle = <0x1d6>;
				linux,phandle = <0x1d6>;

				config {
					pins = "sdc2_data";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			sdc2_cmd_on: sdc2_cmd_on {
				phandle = <0x1d3>;
				linux,phandle = <0x1d3>;

				config {
					pins = "sdc2_cmd";
					drive-strength = <0x0a>;
					bias-pull-up;
				};
			};

			cam_sensor_rear_vana_sleep: cam_sensor_rear_vdig_sleep {
				phandle = <0x1b8>;
				linux,phandle = <0x1b8>;

				mux {
					pins = "gpio134";
					function = "gpio";
				};

				config {
					pins = "gpio134";
					bias-disable;
					drive-strength = <0x02>;
				};
			};

			cam_sensor_mclk0_default: cam_sensor_mclk0_default {
				phandle = <0x1b3>;
				linux,phandle = <0x1b3>;

				mux {
					pins = "gpio26";
					function = "cam_mclk";
				};

				config {
					pins = "gpio26";
					bias-disable;
					drive-strength = <0x02>;
				};
			};

			pmx_adv7533_int: pmx_adv7533_int {
				phandle = <0x1c1>;
				linux,phandle = <0x1c1>;

				adv7533_int_suspend: adv7533_int_suspend {
					phandle = <0x1c3>;
					linux,phandle = <0x1c3>;

					mux {
						pins = "gpio90";
						function = "gpio";
					};

					config {
						pins = "gpio90";
						bias-disable;
						drive-strength = <0x10>;
					};
				};

				adv7533_int_active: adv7533_int_active {
					phandle = <0x1c2>;
					linux,phandle = <0x1c2>;

					mux {
						pins = "gpio90";
						function = "gpio";
					};

					config {
						pins = "gpio90";
						bias-disable;
						drive-strength = <0x10>;
					};
				};
			};

			pmx_mdss: pmx_mdss {
				phandle = <0x1c4>;
				linux,phandle = <0x1c4>;

				mdss_dsi_active: mdss_dsi_active {
					phandle = <0x1c5>;
					linux,phandle = <0x1c5>;

					mux {
						pins = "gpio61";
						function = "gpio";
					};

					config {
						pins = "gpio61";
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						output-high;
					};
				};

				mdss_dsi_suspend: mdss_dsi_suspend {
					phandle = <0x1c6>;
					linux,phandle = <0x1c6>;

					mux {
						pins = "gpio61";
						function = "gpio";
					};

					config {
						pins = "gpio61";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			pmx_ts_int_active {

				ts_int_active: ts_int_active {
					phandle = <0x1e1>;
					linux,phandle = <0x1e1>;

					mux {
						pins = "gpio65";
						function = "gpio";
					};

					config {
						pins = "gpio65";
						drive-strength = <0x08>;
						bias-pull-up;
					};
				};
			};

			blsp2_uart0_sleep: blsp2_uart0_sleep {
				phandle = <0x105>;
				linux,phandle = <0x105>;

				mux {
					pins = "gpio16", "gpio17", "gpio18", "gpio19";
					function = "gpio";
				};

				config {
					pins = "gpio16", "gpio17", "gpio18", "gpio19";
					bias-disable;
					drive-strength = <0x02>;
				};
			};

			wcd9xxx_intr {

				wcd_intr_default: wcd_intr_default {
					phandle = <0x1a2>;
					linux,phandle = <0x1a2>;

					mux {
						pins = "gpio73";
						function = "gpio";
					};

					config {
						pins = "gpio73";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};
			};

			pmx_qdsd_data0 {

				qdsd_data0_jtag: data0_jtag {
					phandle = <0x1f6>;
					linux,phandle = <0x1f6>;

					config {
						pins = "qdsd_data0";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};

				qdsd_data0_swdtrc: data0_swdtrc {
					phandle = <0x1f5>;
					linux,phandle = <0x1f5>;

					config {
						pins = "qdsd_data0";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				qdsd_data0_sdcard: data0_sdcard {
					phandle = <0x1f2>;
					linux,phandle = <0x1f2>;

					config {
						pins = "qdsd_data0";
						drive-strength = <0x08>;
						bias-pull-down;
					};
				};

				qdsd_data0_spmi: data0_spmi {
					phandle = <0x1f7>;
					linux,phandle = <0x1f7>;

					config {
						pins = "qdsd_data0";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				qdsd_data0_trace: data0_trace {
					phandle = <0x1f3>;
					linux,phandle = <0x1f3>;

					config {
						pins = "qdsd_data0";
						drive-strength = <0x08>;
						bias-pull-down;
					};
				};

				qdsd_data0_swduart: data0_uart {
					phandle = <0x1f4>;
					linux,phandle = <0x1f4>;

					config {
						pins = "qdsd_data0";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			pmx_ts_reset_active {

				ts_reset_active: ts_reset_active {
					phandle = <0x1e3>;
					linux,phandle = <0x1e3>;

					mux {
						pins = "gpio64";
						function = "gpio";
					};

					config {
						pins = "gpio64";
						drive-strength = <0x08>;
						bias-pull-up;
					};
				};
			};

			hall_int_pin {
				pins = "gpio13";
				qcom,pin-func = <0x00>;
				label = "hall-irq";
				qcom,num-grp-pins = <0x01>;

				hall_sensor_int_default: hall_sensor_int_default {
					drive-strength = <0x06>;
					phandle = <0x1d9>;
					linux,phandle = <0x1d9>;
					bias-pull-up;
				};
			};

			sdc2_cmd_off: sdc2_cmd_off {
				phandle = <0x1d4>;
				linux,phandle = <0x1d4>;

				config {
					pins = "sdc2_cmd";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			cam_sensor_mclk1_sleep: cam_sensor_mclk1_sleep {
				phandle = <0x1ba>;
				linux,phandle = <0x1ba>;

				mux {
					pins = "gpio27";
					function = "cam_mclk";
				};

				config {
					pins = "gpio27";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};

			pmx_qdsd_data2 {

				qdsd_data2_trace: data2_trace {
					phandle = <0x1fe>;
					linux,phandle = <0x1fe>;

					config {
						pins = "qdsd_data2";
						drive-strength = <0x08>;
						bias-pull-down;
					};
				};

				qdsd_data2_swduart: data2_uart {
					phandle = <0x1ff>;
					linux,phandle = <0x1ff>;

